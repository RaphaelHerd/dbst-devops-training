# Copy this file to .env and paste the key from your trainer.
# .env is listed in .gitignore - never commit it, never paste it into a chat.
AWS_BEARER_TOKEN_BEDROCK=<key from your trainer>
AWS_REGION=us-west-2
# Claude Haiku 5.5 through the US inference profile (tested)
OPSPILOT_MODEL=us.anthropic.claude-haiku-5-5
# Titan Text Embeddings V2 for Lab 4 (tested)
OPSPILOT_EMBED_MODEL=amazon.titan-embed-text-v2:0
